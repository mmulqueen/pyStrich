msgid "Variables"
msgstr "Variablen"

#: of pystrich.code39.Code39Encoder
msgid "The original input text."
msgstr "Der ursprüngliche Eingabetext."

#: of pystrich.code39.Code39Encoder
msgid "List of code values produced by the text encoder."
msgstr "Liste der vom Text-Encoder erzeugten Codewerte."

#: of pystrich.code39.Code39Encoder
msgid "The bar/space pattern as a string of ``\"1\"`` and ``\"0\"``."
msgstr "Das Strich-/Lücken-Muster als Zeichenkette aus ``\"1\"`` und ``\"0\"``."

#: of pystrich.code39.Code39Encoder
msgid "Render-time options dict (empty if none were supplied)."
msgstr "Options-Dict zur Renderzeit (leer, wenn keine angegeben wurden)."

#: of pystrich.code39.Code39Encoder
msgid "Pixel width of the most recently rendered image."
msgstr "Pixelbreite des zuletzt gerenderten Bildes."

#: of pystrich.code39.Code39Encoder
msgid "Pixel height of the most recently rendered image."
msgstr "Pixelhöhe des zuletzt gerenderten Bildes."

