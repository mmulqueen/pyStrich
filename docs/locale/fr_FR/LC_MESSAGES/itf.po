msgid "The computed mod-10 check digit."
msgstr "Le chiffre de contrôle modulo 10 calculé."

#: of pystrich.itf.ITF14Encoder
msgid "The 14-digit code including check digit (== ``digits``)."
msgstr "Le code de 14 chiffres, chiffre de contrôle compris (== ``digits``)."

