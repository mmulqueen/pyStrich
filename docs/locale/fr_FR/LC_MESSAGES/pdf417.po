msgid ""
"Dark-module colour as a 3-, 6- or 8-digit hex string or an ``RGBA``. "
"Defaults to black."
msgstr ""
"Couleur des modules sombres, sous forme de chaîne hexadécimale de 3, 6 ou 8 "
"chiffres ou d'un ``RGBA``. Noir par défaut."

#: of pystrich.matrix_encoder.Matrix2DEncoder.get_eps
#: pystrich.matrix_encoder.Matrix2DEncoder.save_eps
msgid ""
"Background colour as a 3-, 6- or 8-digit hex string or an ``RGBA``, opaque. "
"Defaults to white."
msgstr ""
"Couleur de fond, sous forme de chaîne hexadécimale de 3, 6 ou 8 chiffres ou "
"d'un ``RGBA``, opaque. Blanc par défaut."

