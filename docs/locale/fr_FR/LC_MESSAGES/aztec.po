msgstr "Paramètres"

#: of pystrich.matrix_encoder.Matrix2DEncoder.get_dxf
msgid "Side length of one module in ``units``."
msgstr "Longueur de côté d'un module en ``units``."

#: of pystrich.matrix_encoder.Matrix2DEncoder.get_dxf
