#: ../../cli.rst:-1
msgid "Generate barcodes from the command line with the pyStrich CLI."
msgstr "Générez des codes-barres depuis la ligne de commande avec pyStrich."

#: ../../cli.rst
msgid "Command-line interface"
msgstr "Interface en ligne de commande"

#: ../../cli.rst
msgid ""
"Installing pyStrich exposes a ``pystrich`` console script with a subcommand "
"per format and PNG / SVG / EPS / ASCII / terminal / DXF output."
msgstr ""
"L'installation de pyStrich expose un script de console ``pystrich`` avec une"
" sous-commande par format et une sortie PNG / SVG / EPS / ASCII / terminal /"
" DXF."

#: ../../cli.rst
msgid ""
"To try the CLI without installing pyStrich into an environment, run it "
"through pipx_ or uvx_:"
msgstr ""
"Pour essayer l'outil en ligne de commande sans installer pyStrich dans un "
"environnement, exécutez-le via pipx_ ou uvx_ :"

#: ../../cli.rst
msgid "The last example produces:"
msgstr "Le dernier exemple produit :"

#: ../../cli.rst
msgid "Reference"
msgstr "Référence"

#: ../../cli.rst
msgid ""
"Generate 1D/2D barcodes (Code 39, Code 128, EAN-13, Interleaved 2 of 5, "
"ITF-14, Data Matrix, QR Code, PDF417, Aztec Code). Pass input via --text or "
"stdin."
msgstr ""
"Génère des codes-barres 1D/2D (Code 39, Code 128, EAN-13, 2 parmi 5 "
"entrelacé, ITF-14, Data Matrix, QR Code, PDF417, Aztec Code). Fournissez "
"l'entrée via --text ou stdin."

#: ../../cli.rst
msgid "pystrich options"
msgstr "options de pystrich"

#: ../../cli.rst
msgid "show this help message and exit"
msgstr "affiche ce message d'aide et quitte"

#: ../../cli.rst
msgid "show program's version number and exit"
msgstr "affiche le numéro de version du programme et quitte"

#: ../../cli.rst
msgid "pystrich code39"
msgstr "pystrich code39"

#: ../../cli.rst
msgid "Code 39 (1D)"
msgstr "Code 39 (1D)"

#: ../../cli.rst
msgid "pystrich code39 options"
msgstr "options de pystrich code39"

#: ../../cli.rst
msgid "text to encode (default: read from stdin)"
msgstr "texte à encoder (par défaut : lecture depuis stdin)"

#: ../../cli.rst
msgid "output path; '-' or omitted writes to stdout"
msgstr "chemin de sortie ; '-' ou absent écrit sur stdout"

#: ../../cli.rst
msgid "output format; 'auto' resolves from -o filename or output context"
msgstr ""
"format de sortie ; 'auto' se déduit du nom de fichier -o ou du contexte de "
"sortie"

#: ../../cli.rst
msgid "dark (foreground) colour as 3, 6 or 8 hex digits; png/svg/eps only"
msgstr ""
"couleur sombre (premier plan) sous forme de 3, 6 ou 8 chiffres "
