#: ../../cli.rst
msgid "light (background) colour as 3, 6 or 8 hex digits; png/svg/eps only"
msgstr ""
"couleur claire (arrière-plan) sous forme de 3, 6 ou 8 chiffres "
"hexadécimaux ; png/svg/eps uniquement"

#: ../../cli.rst
msgid "width of the narrowest bar (default: 3)"
msgstr "largeur de la barre la plus étroite (par défaut : 3)"

#: ../../cli.rst
msgid "image height in pixels"
msgstr "hauteur de l'image en pixels"

#: ../../cli.rst
msgid "enable full-ASCII Code 39 encoding"
msgstr "active l'encodage Code 39 ASCII complet"

#: ../../cli.rst
msgid "render the human-readable label below the bars"
msgstr "affiche le libellé en clair sous les barres"

